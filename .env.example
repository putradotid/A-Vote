# ============================================================
# A-Vote — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Firebase Admin SDK (SERVER-SIDE ONLY — never expose to client)
# Obtain from Firebase Console → Project Settings → Service Accounts
# → Generate new private key
# ------------------------------------------------------------
NUXT_FIREBASE_ADMIN_PROJECT_ID=
NUXT_FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key as a single line with literal \n characters
NUXT_FIREBASE_ADMIN_PRIVATE_KEY=

# ------------------------------------------------------------
# Firebase Client SDK (intentionally public — safe to expose)
# Obtain from Firebase Console → Project Settings → Your apps → Web app
# ------------------------------------------------------------
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
